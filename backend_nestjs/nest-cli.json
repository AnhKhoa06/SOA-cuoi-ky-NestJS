{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/sinh-vien-service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/sinh-vien-service/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/sinh-vien-service",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "dang-ky-service": {
      "type": "application",
      "root": "apps/dang-ky-service",
      "entryFile": "main",
      "sourceRoot": "apps/dang-ky-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/dang-ky-service/tsconfig.app.json"
      }
    },
    "de-tai-service": {
      "type": "application",
      "root": "apps/de-tai-service",
      "entryFile": "main",
      "sourceRoot": "apps/de-tai-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/de-tai-service/tsconfig.app.json"
      }
    },
    "sinh-vien-service": {
      "type": "application",
      "root": "apps/sinh-vien-service",
      "entryFile": "main",
      "sourceRoot": "apps/sinh-vien-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/sinh-vien-service/tsconfig.app.json"
      }
    }
  }
}