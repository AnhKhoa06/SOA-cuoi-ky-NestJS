      "path": "./apps/sinh-vien-service/tsconfig.app.json"
    },
    {
      "path": "./apps/de-tai-service/tsconfig.app.json"
    },
    {
      "path": "./apps/dang-ky-service/tsconfig.app.json"
    },
    {
      "path": "./apps/auth-service/tsconfig.app.json"
    },
    {
      "path": "./apps/auth-service/tsconfig.app.json"
    },
    {
      "path": "./apps/bai-giua-ky-soa/tsconfig.app.json"
    },
    {
      "path": "./apps/api-gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/api-gateway/tsconfig.app.json"
    }
  ]
}
